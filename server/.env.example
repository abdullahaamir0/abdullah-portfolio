# Port the API server listens on
PORT=5000

# The URL your React app runs on (Vite dev server, or your deployed frontend).
# Used for CORS — only requests from this origin are allowed.
CLIENT_URL=http://localhost:5173

# --- Email (optional but recommended) ---
# Without these, submitted messages are still saved to server/data/messages.json,
# just not emailed to you. See README.md for how to create a Gmail App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=abdullahaamir924@gmail.com
SMTP_PASS=your-16-character-app-password
TO_EMAIL=abdullahaamir924@gmail.com

# --- Admin access ---
# A private key you choose yourself. Visit /api/messages?key=THIS_VALUE
# to view every message ever submitted, even if email isn't configured.
ADMIN_KEY=choose-a-long-random-string
